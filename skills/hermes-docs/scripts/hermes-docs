#!/bin/sh
# hermes-docs — wrapper for hermes-docs-search
# PATH → cache → GitHub release (best-effort) → cargo build from this repo

set -eu

BIN_NAME="hermes-docs-search"
CACHE_BIN_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hermes-docs-search/bin"
CACHE_BIN="$CACHE_BIN_DIR/$BIN_NAME"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# skills/hermes-docs/scripts → repo root
REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)

run_bin() {
    bin="$1"
    shift
    exec "$bin" "$@"
}

if command -v "$BIN_NAME" >/dev/null 2>&1; then
    run_bin "$(command -v "$BIN_NAME")" "$@"
fi

if [ -x "$CACHE_BIN" ]; then
    run_bin "$CACHE_BIN" "$@"
fi

os="$(uname -s)"
arch="$(uname -m)"
case "$os-$arch" in
    Linux-x86_64)   target="x86_64-unknown-linux-gnu" ;;
    Linux-aarch64)  target="aarch64-unknown-linux-gnu" ;;
    Darwin-x86_64)  target="x86_64-apple-darwin" ;;
    Darwin-arm64)   target="aarch64-apple-darwin" ;;
    *)
        echo "error: unsupported platform: $os $arch" >&2
        target=""
        ;;
esac

github_release_base() {
    if [ -n "${HERMES_DOCS_RELEASE:-}" ]; then
        echo "$HERMES_DOCS_RELEASE"
        return
    fi
    origin=""
    if [ -d "$REPO_DIR/.git" ]; then
        origin=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || true)
    fi
    case "$origin" in
        git@github.com:*.git) origin="https://github.com/${origin#git@github.com:}" ; origin="${origin%.git}" ;;
        git@github.com:*) origin="https://github.com/${origin#git@github.com:}" ;;
        https://github.com/*.git) origin="${origin%.git}" ;;
        https://github.com/*) ;;
        *) origin="" ;;
    esac
    if [ -n "$origin" ]; then
        echo "$origin/releases/download/v0.1.0"
    fi
}

install_from_tar() {
    archive="$1"
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "$tmp_dir"' EXIT
    tar xzf "$archive" -C "$tmp_dir"
    found=$(find "$tmp_dir" -type f -name "$BIN_NAME" -print -quit)
    if [ -z "$found" ]; then
        return 1
    fi
    mkdir -p "$CACHE_BIN_DIR"
    cp "$found" "$CACHE_BIN"
    chmod +x "$CACHE_BIN"
    echo "Installed $BIN_NAME to $CACHE_BIN" >&2
    run_bin "$CACHE_BIN" "$@"
}

if [ -n "$target" ] && command -v curl >/dev/null 2>&1; then
    base=$(github_release_base || true)
    asset="hermes-docs-search-${target}.tar.gz"
    if [ -n "$base" ]; then
        url="$base/$asset"
        echo "Downloading $BIN_NAME for $target..." >&2
        dl=$(mktemp)
        if curl -fsSL "$url" -o "$dl"; then
            install_from_tar "$dl" "$@" || echo "warning: archive had no $BIN_NAME" >&2
        else
            echo "warning: download failed, falling back to build" >&2
        fi
        rm -f "$dl"
    fi
fi

if command -v cargo >/dev/null 2>&1 && [ -f "$REPO_DIR/Cargo.toml" ]; then
    echo "Building $BIN_NAME from source..." >&2
    if cargo build --release --manifest-path "$REPO_DIR/Cargo.toml"; then
        mkdir -p "$CACHE_BIN_DIR"
        cp "$REPO_DIR/target/release/$BIN_NAME" "$CACHE_BIN"
        chmod +x "$CACHE_BIN"
        echo "Built and installed $BIN_NAME to $CACHE_BIN" >&2
        run_bin "$CACHE_BIN" "$@"
    fi
    echo "error: build failed" >&2
    exit 2
fi

echo "error: $BIN_NAME not on PATH, not in cache, and cannot build from $REPO_DIR" >&2
exit 2
