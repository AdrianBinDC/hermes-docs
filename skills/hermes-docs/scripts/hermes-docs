#!/bin/sh
# hermes-docs — wrapper for hermes-docs-search binary
# Resolves binary from PATH → cache dir → download → build from source.

BIN_NAME="hermes-docs-search"
CACHE_BIN_DIR="$HOME/.cache/hermes-docs-search/bin"
CACHE_BIN="$CACHE_BIN_DIR/$BIN_NAME"

# 1. Already on PATH?
if command -v "$BIN_NAME" >/dev/null 2>&1; then
    exec "$BIN_NAME" "$@"
fi

# 2. Cached binary
if [ -x "$CACHE_BIN" ]; then
    exec "$CACHE_BIN" "$@"
fi

# 3. Download release asset (best-effort)
if [ -d "$CACHE_BIN_DIR" ] || [ -d "$HOME/.cache/hermes-docs-search" ]; then
    : # cache dir exists, binary was deleted — fall through to build
fi

os="$(uname -s)"
arch="$(uname -m)"
case "$os" in
    Linux)  os_name="linux" ;;
    Darwin) os_name="darwin" ;;
    *) echo "error: unsupported OS: $os" >&2; exit 2 ;;
esac
case "$arch" in
    x86_64)  arch_name="x86_64" ;;
    aarch64|arm64) arch_name="aarch64" ;;
    *) echo "error: unsupported arch: $arch" >&2; exit 2 ;;
esac

target="${arch_name}-unknown-${os_name}"
tag="v0.1.0"
asset="hermes-docs-search-${target}.tar.gz"
url="https://github.com/hermes-agent/hermes-docs/releases/download/${tag}/${asset}"

echo "Downloading $BIN_NAME for $target..." >&2
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

if command -v curl >/dev/null 2>&1; then
    if curl -fsSL "$url" -o "$tmp_dir/$asset" 2>/dev/null; then
        tar xzf "$tmp_dir/$asset" -C "$tmp_dir" 2>/dev/null
        if [ -f "$tmp_dir/$BIN_NAME" ]; then
            mkdir -p "$CACHE_BIN_DIR"
            cp "$tmp_dir/$BIN_NAME" "$CACHE_BIN"
            chmod +x "$CACHE_BIN"
            echo "Installed $BIN_NAME to $CACHE_BIN" >&2
            exec "$CACHE_BIN" "$@"
        fi
    fi
    echo "warning: download failed, falling back to build" >&2
else
    echo "warning: curl not available, falling back to build" >&2
fi

# 4. Build from source
if command -v cargo >/dev/null 2>&1; then
    echo "Building $BIN_NAME from source..." >&2
    repo_dir="$HOME/dev/hermes-docs"
    if [ ! -d "$repo_dir" ]; then
        echo "error: source repo not found at $repo_dir" >&2
        exit 2
    fi
    if cargo build --release --manifest-path "$repo_dir/Cargo.toml" 2>&1; then
        mkdir -p "$CACHE_BIN_DIR"
        cp "$repo_dir/target/release/$BIN_NAME" "$CACHE_BIN"
        chmod +x "$CACHE_BIN"
        echo "Built and installed $BIN_NAME to $CACHE_BIN" >&2
        exec "$CACHE_BIN" "$@"
    fi
    echo "error: build failed" >&2
    exit 2
fi

echo "error: no cargo available to build $BIN_NAME" >&2
exit 2
