#!/usr/bin/env sh
# hermes-docs — wrapper for hermes-docs-search
# PATH → cache → optional release download (HERMES_DOCS_RELEASE) → cargo build from this repo

set -eu

DEFAULT_JSON_TOP_K=3

# Last positional argument is the query; everything before it is flags.
if [ "$#" -lt 1 ]; then
    echo "error: missing query argument" >&2
    exit 2
fi

# Save args — set -- clears positional parameters during rebuild.
saved_n=$#
i=1
while [ "$i" -le "$saved_n" ]; do
    eval "saved$i=\${$i}"
    i=$((i + 1))
done

eval "QUERY=\${saved$saved_n}"
FLAG_N=$((saved_n - 1))

has_json=0
has_top_k=0

i=1
while [ "$i" -le "$FLAG_N" ]; do
    eval "arg=\${saved$i}"
    case "$arg" in
        --json) has_json=1 ;;
        -k|--top-k) has_top_k=1 ;;
        --top-k=*) has_top_k=1 ;;
        -8|-[0-9]*) has_top_k=1 ;;
    esac
    i=$((i + 1))
done

set --
i=1
while [ "$i" -le "$FLAG_N" ]; do
    eval "arg=\${saved$i}"
    case "$arg" in
        -8)
            # Common typo for -k; keep payload small (same as JSON default).
            set -- "$@" -k "$DEFAULT_JSON_TOP_K"
            ;;
        -k|--top-k)
            set -- "$@" "$arg"
            i=$((i + 1))
            if [ "$i" -le "$FLAG_N" ]; then
                eval "set -- \"\$@\" \"\${saved$i}\""
            fi
            ;;
        --top-k=*)
            set -- "$@" "$arg"
            ;;
        -[0-9]*)
            n="${arg#-}"
            case "$n" in
                *[!0-9]*)
                    set -- "$@" "$arg"
                    ;;
                *)
                    set -- "$@" -k "$n"
                    ;;
            esac
            ;;
        *)
            set -- "$@" "$arg"
            ;;
    esac
    i=$((i + 1))
done

if [ "$has_json" -eq 1 ] && [ "$has_top_k" -eq 0 ]; then
    set -- "$@" -k "$DEFAULT_JSON_TOP_K"
fi

set -- "$@" "$QUERY"

BIN_NAME="hermes-docs-search"
CACHE_BIN_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hermes-docs-search/bin"
CACHE_BIN="$CACHE_BIN_DIR/$BIN_NAME"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# skills/hermes-docs/scripts → repo root
REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)

run_bin() {
    bin="$1"
    shift
    exec "$bin" "$@"
}

if command -v "$BIN_NAME" >/dev/null 2>&1; then
    run_bin "$(command -v "$BIN_NAME")" "$@"
fi

if [ -x "$CACHE_BIN" ]; then
    run_bin "$CACHE_BIN" "$@"
fi

os="$(uname -s)"
arch="$(uname -m)"
case "$os-$arch" in
    Linux-x86_64)   target="x86_64-unknown-linux-gnu" ;;
    Linux-aarch64)  target="aarch64-unknown-linux-gnu" ;;
    Darwin-x86_64)  target="x86_64-apple-darwin" ;;
    Darwin-arm64)   target="aarch64-apple-darwin" ;;
    *)
        echo "error: unsupported platform: $os $arch" >&2
        target=""
        ;;
esac

release_download_base() {
    # Opt-in only: do not infer a GitHub repo from git remotes on first run.
    if [ -n "${HERMES_DOCS_RELEASE:-}" ]; then
        echo "$HERMES_DOCS_RELEASE"
    fi
}

install_from_tar() {
    archive="$1"
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "$tmp_dir"' EXIT
    tar xzf "$archive" -C "$tmp_dir"
    found=$(find "$tmp_dir" -type f -name "$BIN_NAME" -print -quit)
    if [ -z "$found" ]; then
        return 1
    fi
    mkdir -p "$CACHE_BIN_DIR"
    cp "$found" "$CACHE_BIN"
    chmod +x "$CACHE_BIN"
    echo "Installed $BIN_NAME to $CACHE_BIN" >&2
    run_bin "$CACHE_BIN" "$@"
}

if [ -n "$target" ] && command -v curl >/dev/null 2>&1; then
    base=$(release_download_base || true)
    if [ -n "$base" ]; then
        asset="hermes-docs-search-${target}.tar.gz"
        url="$base/$asset"
        echo "Downloading $BIN_NAME for $target from $base..." >&2
        dl=$(mktemp)
        if curl -fsSL "$url" -o "$dl"; then
            install_from_tar "$dl" "$@" || echo "warning: archive had no $BIN_NAME" >&2
        else
            echo "warning: download failed, falling back to build" >&2
        fi
        rm -f "$dl"
    fi
fi

if command -v cargo >/dev/null 2>&1 && [ -f "$REPO_DIR/Cargo.toml" ]; then
    echo "Building $BIN_NAME from source..." >&2
    if cargo build --release --manifest-path "$REPO_DIR/Cargo.toml"; then
        mkdir -p "$CACHE_BIN_DIR"
        cp "$REPO_DIR/target/release/$BIN_NAME" "$CACHE_BIN"
        chmod +x "$CACHE_BIN"
        echo "Built and installed $BIN_NAME to $CACHE_BIN" >&2
        run_bin "$CACHE_BIN" "$@"
    fi
    echo "error: build failed" >&2
    exit 2
fi

echo "error: $BIN_NAME not on PATH, not in cache, and cannot build from $REPO_DIR" >&2
echo "hint: install to $CACHE_BIN, set HERMES_DOCS_RELEASE to a GitHub release asset base URL, or run from a checkout with cargo" >&2
exit 2
